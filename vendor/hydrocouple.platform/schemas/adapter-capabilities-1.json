{
  "$defs": {
    "JobClass": {
      "enum": [
        "single",
        "evaluator-pool",
        "multi-rank",
        "analysis"
      ],
      "title": "JobClass",
      "type": "string"
    },
    "TaskSize": {
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "exclusiveMinimum": 0,
          "title": "Cpu",
          "type": "number"
        },
        "memory_gib": {
          "exclusiveMinimum": 0,
          "title": "Memory Gib",
          "type": "number"
        }
      },
      "required": [
        "cpu",
        "memory_gib"
      ],
      "title": "TaskSize",
      "type": "object"
    }
  },
  "$id": "https://hydrocouple.org/schema/platform/adapter-capabilities-1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter": {
      "title": "Adapter",
      "type": "string"
    },
    "family": {
      "enum": [
        "local",
        "kubernetes",
        "batch",
        "serverless",
        "hpc"
      ],
      "title": "Family",
      "type": "string"
    },
    "gpu": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gpu"
    },
    "has_runtime_cap": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "False when the service has no cap; None when it is unknown.",
      "title": "Has Runtime Cap"
    },
    "idempotent_submit": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotent Submit"
    },
    "interruption_tolerant": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Interruption Tolerant"
    },
    "job_classes": {
      "items": {
        "$ref": "#/$defs/JobClass"
      },
      "title": "Job Classes",
      "type": "array"
    },
    "max_cpu": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Cpu"
    },
    "max_memory_gib": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Memory Gib"
    },
    "max_parallel_tasks": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Parallel Tasks"
    },
    "max_task_seconds": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Hard runtime cap per task; None when the service has none.",
      "title": "Max Task Seconds"
    },
    "provider_retries": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Retries the service performs itself; must be 0.",
      "title": "Provider Retries"
    },
    "runs_images": {
      "default": true,
      "description": "False for the local pool, which runs the installed runner.",
      "title": "Runs Images",
      "type": "boolean"
    },
    "scratch_gib": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scratch Gib"
    },
    "scratch_in_memory": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "True when writes to scratch use the task's memory.",
      "title": "Scratch In Memory"
    },
    "status_integration": {
      "anyOf": [
        {
          "enum": [
            "direct",
            "watch",
            "events",
            "polling"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status Integration"
    },
    "submission_rate_per_second": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Submission Rate Per Second"
    },
    "task_sizes": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/TaskSize"
          },
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The CPU and memory pairs the service offers, when it offers only some (Fargate). A request runs on the smallest pair with enough of both. None when any combination up to max_cpu and max_memory_gib runs.",
      "title": "Task Sizes"
    }
  },
  "required": [
    "adapter",
    "family",
    "job_classes"
  ],
  "title": "AdapterCapabilities",
  "type": "object"
}
