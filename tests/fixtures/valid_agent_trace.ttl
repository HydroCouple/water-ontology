@prefix wsys: <https://w3id.org/wsys/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://w3id.org/wsys/session/> .
@prefix ag:   <https://w3id.org/wsys/agent/> .

# a person, the AI agent that acts for her in one session, a registered tool and one call to it
ag:alice a wsys:Agent ; wsys:class_iri wsys:Agent ; wsys:agent_kind "PERSON" .
ag:ai-s1 a wsys:Agent ; wsys:class_iri wsys:Agent ; wsys:agent_kind "AI_AGENT" ; prov:actedOnBehalfOf ag:alice .
ex:s1    a wsys:AgentSession ; wsys:class_iri wsys:AgentSession ; wsys:session_id "s1" ; prov:wasAssociatedWith ag:ai-s1 ;
         wsys:client "openswmm.mcp" ; wsys:client_version "0.4.0" ; wsys:model "example-model" .
wsys:tool-inspect a wsys:Tool ; wsys:class_iri wsys:Tool ; wsys:tool_name "inspect" ; wsys:tool_version "0.4.0" ; wsys:read_only true .
ex:s1-c1 a wsys:ToolCall ; wsys:class_iri wsys:ToolCall ; wsys:tool_call_id "c1" ; wsys:in_session ex:s1 ; wsys:tool wsys:tool-inspect ;
         wsys:effect "READ" ; wsys:sequence 1 ; prov:wasAssociatedWith ag:ai-s1 ;
         wsys:arguments_sha256 "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"^^xsd:hexBinary ; prov:startedAtTime "2026-11-20T15:00:00Z"^^xsd:dateTime .
