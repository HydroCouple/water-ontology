@prefix wsys: <https://w3id.org/wsys/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://w3id.org/wsys/example/> .

ex:study-2 a wsys:Study ; wsys:class_iri wsys:Study ; wsys:study_id "std_2" ; prov:wasGeneratedBy ex:run-pool ;
    wsys:acceptance_rule [ a wsys:AcceptanceRule ;
        wsys:thresholds [ a wsys:AcceptanceThreshold ; wsys:at_least "0.5"^^xsd:float ] ] .
